# LevelUP Backend Environment Variables

# Application Settings
PROJECT_NAME=SkillRoute
ENV=production

# ── LLM Configuration ───────────────────────────────────
# NVIDIA NIM (recommended — free, tool calling, 1M context):
OPENAI_API_KEY=nvapi-your_nvidia_nim_key_here
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Or MiniMax-M3:
# OPENAI_API_KEY=your_minimax_key_here
# OPENAI_BASE_URL=https://api.gmi-serving.com/v1
# OPENAI_MODEL=MiniMaxAI/MiniMax-M3

# Or Azure OpenAI:
# AZURE_OPENAI_API_KEY=your_azure_openai_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# Firebase Configuration (from firebase_key.json)
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json
# Or paste the service account JSON string directly:
# FIREBASE_SERVICE_ACCOUNT={...}
